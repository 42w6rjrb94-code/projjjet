#pragma once
#include <Windows.h>
#include <random>
#include <thread>
#include <chrono>

namespace Input {
    static std::mt19937 rng{ std::random_device{}() };

    static int Jitter(int base, int var) {
        if (var <= 0) return base;
        std::uniform_int_distribution<int> d(-var, var);
        return std::max(0, base + d(rng));
    }
    static void PressKey(WORD vk, int holdMs = 50, int var = 8) {
        INPUT i[2]{};
        i[0].type = i[1].type = INPUT_KEYBOARD;
        i[0].ki.wVk = i[1].ki.wVk = vk;
        i[1].ki.dwFlags = KEYEVENTF_KEYUP;
        SendInput(1, &i[0], sizeof(INPUT));
        std::this_thread::sleep_for(std::chrono::milliseconds(Jitter(holdMs, var)));
        SendInput(1, &i[1], sizeof(INPUT));
    }
    static void HoldKey(WORD vk) {
        INPUT i{}; i.type = INPUT_KEYBOARD; i.ki.wVk = vk;
        SendInput(1, &i, sizeof(INPUT));
    }
    static void ReleaseKey(WORD vk) {
        INPUT i{}; i.type = INPUT_KEYBOARD;
        i.ki.wVk = vk; i.ki.dwFlags = KEYEVENTF_KEYUP;
        SendInput(1, &i, sizeof(INPUT));
    }

    constexpr WORD KEY_DODGE  = 'X';
    constexpr WORD KEY_JUMP   = 'W';
    constexpr WORD KEY_ATTACK = 'A';
    constexpr WORD KEY_SIG    = 'Z';
    constexpr WORD KEY_LEFT   = VK_LEFT;
    constexpr WORD KEY_RIGHT  = VK_RIGHT;
    constexpr WORD KEY_DOWN   = VK_DOWN;
    constexpr WORD KEY_UP     = VK_UP;
}
