#pragma once
#include <Windows.h>
#include <TlHelp32.h>
#include <string>
#include <vector>

class Memory {
public:
    HANDLE    handle   = nullptr;
    DWORD     pid      = 0;
    uintptr_t monoBase = 0;
    uintptr_t gameBase = 0;
    HWND      gameHwnd = nullptr;

    ~Memory() { if (handle) CloseHandle(handle); }

    bool Attach(const std::wstring& proc) {
        pid = FindPID(proc);
        if (!pid) return false;
        handle = OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid);
        if (!handle) return false;
        monoBase = GetModBase(L"mono-2.0-bdwgc.dll");
        gameBase = GetModBase(L"Brawlhalla.exe");
        gameHwnd = FindWindowW(nullptr, L"Brawlhalla");
        return monoBase && gameBase;
    }

    template<typename T> T Read(uintptr_t addr) const {
        T v{}; SIZE_T n;
        ReadProcessMemory(handle, (LPCVOID)addr, &v, sizeof(T), &n);
        return v;
    }
    template<typename T> void Write(uintptr_t addr, T val) {
        WriteProcessMemory(handle, (LPVOID)addr, &val, sizeof(T), nullptr);
    }
    std::string ReadMonoStr(uintptr_t p) {
        if (!p) return "";
        int32_t len = Read<int32_t>(p + 0x10);
        if (len <= 0 || len > 256) return "";
        std::vector<wchar_t> buf(len + 1, 0);
        ReadProcessMemory(handle, (LPCVOID)(p + 0x14), buf.data(), len * 2, nullptr);
        return std::string(buf.begin(), buf.begin() + len);
    }

private:
    DWORD FindPID(const std::wstring& name) {
        PROCESSENTRY32W pe{ sizeof(pe) };
        HANDLE s = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
        DWORD r = 0;
        if (Process32FirstW(s, &pe)) do {
            if (name == pe.szExeFile) { r = pe.th32ProcessID; break; }
        } while (Process32NextW(s, &pe));
        CloseHandle(s); return r;
    }
    uintptr_t GetModBase(const std::wstring& dll) {
        MODULEENTRY32W me{ sizeof(me) };
        HANDLE s = CreateToolhelp32Snapshot(TH32CS_SNAPMODULE|TH32CS_SNAPMODULE32, pid);
        uintptr_t r = 0;
        if (Module32FirstW(s, &me)) do {
            if (dll == me.szModule) { r = (uintptr_t)me.modBaseAddr; break; }
        } while (Module32NextW(s, &me));
        CloseHandle(s); return r;
    }
};
