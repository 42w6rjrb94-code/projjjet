#pragma once
#include "entities.hpp"
#include "input.hpp"
#include "config.hpp"
#include <vector>
#include <thread>
#include <chrono>

class WeaponSnap {
    Config& cfg;
public:
    WeaponSnap(Config& c) : cfg(c) {}

    const BHWeapon* Nearest(const std::vector<BHWeapon>& weapons) {
        const BHWeapon* best = nullptr;
        for (const auto& w : weapons)
            if (!best || w.distToLocal < best->distToLocal) best = &w;
        return best;
    }

    void Tick(const std::vector<BHPlayer>& players,
              const std::vector<BHWeapon>& weapons) {
        if (!cfg.weaponSnap) return;
        const BHPlayer* local = nullptr;
        for (const auto& p : players) if (p.isLocal) { local = &p; break; }
        if (!local || local->weaponType != -1) return;

        const BHWeapon* w = Nearest(weapons);
        if (!w || w->distToLocal > cfg.snapRangeUnits) return;

        WORD dir = w->pos.x > local->worldPos.x ? Input::KEY_RIGHT : Input::KEY_LEFT;
        Input::HoldKey(dir);
        std::this_thread::sleep_for(std::chrono::milliseconds(100));
        Input::ReleaseKey(dir);
    }
};
