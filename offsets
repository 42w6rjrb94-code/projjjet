cmake_minimum_required(VERSION 3.20)
project(bhcheat CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)

# ── Sources projet ──────────────────────────────────────────────────────────
file(GLOB_RECURSE BH_SOURCES
    "${CMAKE_SOURCE_DIR}/src/*.cpp"
    "${CMAKE_SOURCE_DIR}/src/*.hpp"
)

# ── ImGui sources ────────────────────────────────────────────────────────────
set(IMGUI_DIR "${CMAKE_SOURCE_DIR}/vendor/imgui")

set(IMGUI_SOURCES
    "${IMGUI_DIR}/imgui.cpp"
    "${IMGUI_DIR}/imgui_draw.cpp"
    "${IMGUI_DIR}/imgui_tables.cpp"
    "${IMGUI_DIR}/imgui_widgets.cpp"
    "${IMGUI_DIR}/backends/imgui_impl_dx11.cpp"
    "${IMGUI_DIR}/backends/imgui_impl_win32.cpp"
)

# ── Exécutable ───────────────────────────────────────────────────────────────
add_executable(bhcheat ${BH_SOURCES} ${IMGUI_SOURCES})

# ── Includes ─────────────────────────────────────────────────────────────────
target_include_directories(bhcheat PRIVATE
    "${CMAKE_SOURCE_DIR}/src"
    "${IMGUI_DIR}"
    "${IMGUI_DIR}/backends"
    "${CMAKE_SOURCE_DIR}/vendor/nlohmann"   # → #include <nlohmann/json.hpp>
)

# ── Libs Windows ─────────────────────────────────────────────────────────────
target_link_libraries(bhcheat PRIVATE
    d3d11
    d3dcompiler
    dxgi
    dwmapi
    user32
    gdi32
)

# ── Flags MSVC ───────────────────────────────────────────────────────────────
if(MSVC)
    target_compile_options(bhcheat PRIVATE
        /W3
        /O2
        /EHsc
        /MP
    )
    # Évite les warnings MSVC sur les fonctions C standard
    target_compile_definitions(bhcheat PRIVATE
        _CRT_SECURE_NO_WARNINGS
        NOMINMAX
        WIN32_LEAN_AND_MEAN
    )
endif()
