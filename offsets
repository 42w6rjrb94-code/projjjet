namespace HWID {
    static std::string GetCPUID() {
        int r[4]{};
        __cpuid(r, 1);
        std::ostringstream ss;
        ss << std::hex << r[0] << r[3];
        return ss.str();
    }
    static std::string GetVolSerial() {
        DWORD s = 0;
        GetVolumeInformationW(L"C:\\", nullptr, 0, &s, nullptr, nullptr, nullptr, 0);
        std::ostringstream ss;
        ss << std::hex << std::uppercase << s;
        return ss.str();
    }
    static std::string Generate() {
        std::string raw = GetCPUID() + GetVolSerial();
        unsigned char hash[SHA256_DIGEST_LENGTH];
        SHA256((unsigned char*)raw.c_str(), raw.size(), hash);
        std::ostringstream ss;
        for (int i = 0; i < 8; i++)
            ss << std::hex << std::uppercase
               << std::setw(2) << std::setfill('0') << (int)hash[i];
        return ss.str();
    }
