# Lance ça dans PowerShell admin dans la VM

# 1. MachineGuid — doit être un GUID random, pas celui d'origine Windows
(Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Cryptography").MachineGuid

# 2. Hostname actuel
$env:COMPUTERNAME

# 3. TTL — doit être 64
(Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters").DefaultTTL

# 4. Lock présent
Get-Content "C:\spoof.lock"
